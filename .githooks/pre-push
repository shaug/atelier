#!/usr/bin/env bash
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
# The mailbox experiment creates independent repositories. Git exports local
# repository variables to hooks, so clear them before testing those repositories.
while IFS= read -r git_variable; do
  unset "$git_variable"
done < <(git rev-parse --local-env-vars)

just test
